		Enabled = false
	}
})

local ESPTab = Window:CreateTab("ESP")
local AimTab = Window:CreateTab("Aim Assist")

--==================================================
-- TEAM CHECK
--==================================================

local function IsEnemy(player)
	if not player.Team or not LocalPlayer.Team then
		return true
	end

	return player.Team ~= LocalPlayer.Team
end

--==================================================
-- ESP
--==================================================

local function RemoveHighlight(player)
	if Highlights[player] then
		Highlights[player]:Destroy()
		Highlights[player] = nil
	end
end

local function UpdateHighlight(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character then
		RemoveHighlight(player)
		return
	end

	local isEnemy = IsEnemy(player)

	if isEnemy and not ESPEnabled then
		RemoveHighlight(player)
		return
	end

	if not isEnemy and not TeamESPEnabled then
		RemoveHighlight(player)
		return
	end

	local highlight = Highlights[player]

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "OwnerESP"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.55
		highlight.OutlineTransparency = 0
		highlight.Parent = character

		Highlights[player] = highlight
	end

	-- Keep it attached to the current character
	if highlight.Parent ~= character then
		highlight.Parent = character
	end

	if isEnemy then
		highlight.FillColor = EnemyColor
		highlight.OutlineColor = Color3.new(1, 1, 1)
	else
		highlight.FillColor = TeamColor
		highlight.OutlineColor = Color3.new(1, 1, 1)
	end
end

local function UpdateAllESP()
	for _, player in ipairs(Players:GetPlayers()) do
		UpdateHighlight(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		UpdateHighlight(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	RemoveHighlight(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			UpdateHighlight(player)
		end)
	end
end

