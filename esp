-- FLY
local flyConnection

local function stopFly()
	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if humanoid then
		humanoid.PlatformStand = false
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	flyButton.Text = "FLY: OFF"
	flyButton.BackgroundColor3 = Color3.fromRGB(180,50,50)
end

local function startFly()
	if not root or not humanoid then
		return
	end

	flying = true
	humanoid.PlatformStand = true

	flyButton.Text = "FLY: ON"
	flyButton.BackgroundColor3 = Color3.fromRGB(40,170,70)

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not root or not root.Parent then
			return
		end

		local camera = workspace.CurrentCamera
		local direction = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.yAxis
		end

		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.yAxis
		end

		if direction.Magnitude > 0 then
			direction = direction.Unit
		end

		root.AssemblyLinearVelocity = direction * flySpeed
	end)
end

flyButton.MouseButton1Click:Connect(function()
	if flying then
		stopFly()
	else
		startFly()
	end
end)

speedBox.FocusLost:Connect(function()
	local value = tonumber(speedBox.Text)

	if value then
		flySpeed = math.clamp(value, 1, 500)
	else
		speedBox.Text = tostring(flySpeed)
	end
end)

-- ESP
local function addESP(otherPlayer)
	if otherPlayer == player then
		return
	end

	local function apply(character)
		if not espEnabled then
			return
		end

		local old = character:FindFirstChild("MyESP")
		if old then
			old:Destroy()
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "MyESP"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0

		-- GREEN = TEAM
		-- RED = ENEMY
		if player.Team ~= nil and otherPlayer.Team == player.Team then
			highlight.FillColor = Color3.fromRGB(0,255,0)
			highlight.OutlineColor = Color3.fromRGB(0,255,0)
		else
			highlight.FillColor = Color3.fromRGB(255,0,0)
			highlight.OutlineColor = Color3.fromRGB(255,0,0)
		end

		highlight.Parent = character
	end

	if otherPlayer.Character then
		apply(otherPlayer.Character)
	end

	otherPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.2)
		apply(char)
	end)
end

local function removeESP()
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer.Character then
			local esp = otherPlayer.Character:FindFirstChild("MyESP")
			if esp then
				esp:Destroy()
			end
		end
	end
end

for _, otherPlayer in ipairs(Players:GetPlayers()) do
	addESP(otherPlayer)
end

Players.PlayerAdded:Connect(function(otherPlayer)
	addESP(otherPlayer)
end)

espButton.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled

	if espEnabled then
		espButton.Text = "ESP: ON"
		espButton.BackgroundColor3 = Color3.fromRGB(40,170,70)

		for _, otherPlayer in ipairs(Players:GetPlayers()) do
			addESP(otherPlayer)
		end
	else
		espButton.Text = "ESP: OFF"
		espButton.BackgroundColor3 = Color3.fromRGB(180,50,50)
		removeESP()
	end
end)
