
--// OWNER COMBAT TOOLS
--// LocalScript -> StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local OWNER_USER_ID = 8321894484 -- YOUR USER ID

if LocalPlayer.UserId ~= OWNER_USER_ID then
	return
end

local EnemyColor = Color3.fromRGB(255, 60, 60)
local TeamColor = Color3.fromRGB(60, 150, 255)

local ESPEnabled = false
local TeamESPEnabled = false
local AimAssistEnabled = false

local AimFOV = 150
local AimSmoothness = 0.15
local AimPart = "Head"

local Highlights = {}

--==================================================
-- RAYFIELD
--==================================================

local Rayfield = loadstring(game:HttpGet(
	"https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
	Name = "Owner Tools",
	LoadingTitle = "Owner Tools",
	LoadingSubtitle = "ESP / Aim Assist",

